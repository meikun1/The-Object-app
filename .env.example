# --- База данных и кэш (совпадают с docker-compose.yml) ---
DATABASE_URL="postgresql://object:object@localhost:5432/object?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Секреты приложения (СГЕНЕРИРУЙТЕ свои значения) ---
# Подпись токенов столов и серверных сессий. Любая длинная случайная строка.
SESSION_SECRET="change-me-to-a-long-random-string"
# Токен входа в админку (единственный администратор).
ADMIN_ACCESS_TOKEN="change-me-admin-token"

# --- Telegram-бот / приём брони ---
# Токен бота (BotFather). Используется и для оповещений о брони, и для бота бармена (Этап 4).
BOT_TOKEN="8877197039:AAG63DJ0Xw3hK73WN3uFPQd-MG4ZtqnanIU"
# Куда бот шлёт уведомления о броне (chat_id личного чата или группы).
BOOKING_CHAT_ID="8877197039"
# Пароль для входа сотрудников через бота (Этап 4).
BOT_ACCESS_PASSWORD="change-me-staff-password"

# --- Заведение ---
TZ="Europe/Moscow"
# График закрытия для авто-снятия со смены (Этап 4).
# Формат: день недели(0=вс..6=сб) = час закрытия по локальному времени.
BAR_CLOSE_SCHEDULE="0:2,1:2,2:2,3:2,4:2,5:3,6:3"

# --- Сетевые порты приложения ---
API_PORT=4000
WEB_PORT=3000
# Публичный адрес приложения (используется в QR-ссылках столов).
PUBLIC_APP_URL="http://localhost:3000"
# Откуда web-приложению ходить в API (на проде — пусто/относительный путь за Caddy).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- r_keeper (Этап 7; сейчас работает мок) ---
RKEEPER_MODE="mock"
