{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS-вариант API для VPS-деплоя. Схема Prisma общая, лежит в apps/web/prisma.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema=../web/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=../web/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^20.16.10",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
